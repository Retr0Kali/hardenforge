# Placeholders only. Never commit a real .env.
SENTINEL_API_TOKEN=change-me-to-a-long-random-string
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this OUTSIDE the data directory (OS keychain / secret manager preferred).
SENTINEL_MASTER_KEY=
SENTINEL_DATA_DIR=./data
SENTINEL_RULES_DIR=./rules

# Provider keys (optional; env takes priority over the encrypted store)
SENTINEL_GEMINI_API_KEY=
SENTINEL_OPENAI_API_KEY=
SENTINEL_ANTHROPIC_API_KEY=

# Models are deliberately NOT defaulted: set the ones you have access to.
SENTINEL_GEMINI_MODEL=
SENTINEL_OPENAI_MODEL=
SENTINEL_ANTHROPIC_MODEL=

# Optional endpoint overrides and pricing (USD per 1M tokens) for ESTIMATED cost
# SENTINEL_OPENAI_ENDPOINT=
# SENTINEL_OPENAI_PRICE_IN=
# SENTINEL_OPENAI_PRICE_OUT=

# Data categories the user allows to leave the machine (comma separated): findings,evidence,inventory
SENTINEL_AI_SHARING=
